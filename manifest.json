{
  "manifest_version": 3,
  "name": "PkgTicker — Package Downloads Table",
  "version": "1.0.1",
  "description": "Per-day download counts for GitHub package pages and npm pages, in a table, on click.",
  "homepage_url": "https://github.com/xiaohanyu/pkgticker",
  "permissions": ["activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Toggle downloads table",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
